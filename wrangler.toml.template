# =============================================================================
# CIFHF website — Cloudflare Pages configuration REFERENCE (.template)
#
# *** THIS FILE IS NOT LIVE CONFIG. IT MUST STAY NAMED *.template. ***
# Pages reads an actual root-level `wrangler.toml` on every deploy. The
# real Cloudflare Pages project ("cifhf-demo", already created, already
# connected to this GitHub repo, production branch `master`) is configured
# directly in the Cloudflare dashboard. If a real `wrangler.toml` is ever
# added back at the repo root, Pages will treat it as authoritative on the
# next deploy — its [vars] would overwrite/lock whatever is set in the
# dashboard, and `name` would need to exactly match "cifhf-demo" or Pages
# may refuse the deploy or create a second project. Rename a copy of this
# file only with eyes open to that, and only once every PETER/MELANIE
# DECIDES item below is actually settled.
#
# No secrets, no real domain, no real email address live in this file —
# it's reference only, kept in the repo so the dashboard settings below
# are documented somewhere version-controlled.
#
# Three things here are PETER/MELANIE DECIDES, not Ember's call:
#   1. Which domain the site lives on (already on Cloudflare Pages at
#      cifhf-demo.pages.dev; a custom domain is still open) — and either
#      way, leave the send_email section below commented out until it's
#      actually wired up; the contact form correctly shows "not connected
#      yet" until then.
#   2. The real recipient address for CONTACT_TO.
#   3. Whether to enable Turnstile (an extra spam check) — optional.
#
# See DEPLOY_CONTACT.md at the repo root for the step-by-step checklist.
# =============================================================================

name = "cifhf-demo"                    # the real Cloudflare Pages project name — already created, already connected to this repo
pages_build_output_dir = "."           # the site is static HTML at the repo root — no build step

compatibility_date = "2026-10-02"      # bump only if a newer Functions runtime feature is needed

# -----------------------------------------------------------------------------
# Email Workers `send_email` binding — lets functions/api/contact.js send
# mail with no third-party email service. Requires, in order:
#   1. The chosen domain is added to Cloudflare (nameservers pointed there).
#   2. Email Routing is turned on for that domain (Cloudflare dashboard ->
#      the domain -> Email -> Email Routing).
#   3. The destination address below is VERIFIED — Cloudflare sends a
#      one-time confirmation email to it that someone must click.
#
# Until all three are true, leave this block commented out. The contact
# form will correctly keep showing "not connected yet" rather than claim
# a success it can't deliver.
# -----------------------------------------------------------------------------

# [[send_email]]
# name = "SEND_EMAIL"
# destination_address = "PLACEHOLDER_MELANIE_DECIDES@example.org"   # must match the verified Email Routing destination

# -----------------------------------------------------------------------------
# Environment variables consumed by functions/api/contact.js.
#
# Set the REAL values as "Environment variables" in the Cloudflare Pages
# dashboard (cifhf-demo project -> Settings -> Environment variables), not
# here. This file stays a .template specifically so these placeholders
# never become the live config and never lock out the dashboard values.
# -----------------------------------------------------------------------------

[vars]
CONTACT_TO = "PLACEHOLDER_SET_IN_DASHBOARD_NOT_HERE"   # PETER/MELANIE DECIDES — the real recipient inbox
SEND_FROM  = "PLACEHOLDER_SET_IN_DASHBOARD_NOT_HERE"   # must be an address on the domain once it's on Cloudflare

# Optional spam gate. Leave commented out to keep Turnstile disabled — the
# honeypot field and minimum-fill-time check in contact.js still apply
# either way, with or without this.
# TURNSTILE_SECRET_KEY = "PLACEHOLDER_SET_IN_DASHBOARD_NOT_HERE"
